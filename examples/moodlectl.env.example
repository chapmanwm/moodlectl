# Environment-based auth for moodlectl (CI, containers, agent runtimes).
# Inject real values from a secret store. Never commit them.

# Either a session cookie...
MOODLE_SESSION=replace-me
# ...or UofG credentials for `moodlectl login` / `moodlectl timetable`
# MOODLE_USERNAME=1234567x@student.gla.ac.uk
# MOODLE_PASSWORD=replace-me
# UOFG_GUID=1234567x

# Optional
# MOODLE_BASE_URL=https://moodle.gla.ac.uk
# MOODLECTL_CONFIG_DIR=/path/to/private/dir
# MOODLECTL_SECRETS_DIR=/path/the/agent/sandbox/cannot/read
# MOODLECTL_CORPUS=/path/to/corpus
# MOODLECTL_REAUTH_HINT="Run: moodlectl login"
